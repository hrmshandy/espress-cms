{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./vue.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "types": ["node", "vue"],
    "paths": {
      "#imports": ["./.nuxt/types/imports"],
      "#components": ["./.nuxt/components"],
      "#app": ["./.nuxt/app"],
      "#composables": ["./.nuxt/composables"]
    }
  }
}
