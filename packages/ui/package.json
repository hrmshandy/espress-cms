{
  "name": "@espress/ui",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./vue": "./src/vue/index.ts",
    "./lib": "./src/lib/index.ts",
    "./astro": "./src/astro/index.ts",
    "./styles": "./src/styles/main.css",
    "./nuxt": "./nuxt.config.ts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
