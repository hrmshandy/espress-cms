    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.1.1",
    "tsup": "^8.0.2",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.1",
    "@tanstack/vue-table": "^8.21.2",
    "@vueuse/core": "^13.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^3.16.2",
    "reka-ui": "^2.2.0",
    "shadcn-nuxt": "^0.9.0",
    "tailwind-merge": "^2.6.0",
