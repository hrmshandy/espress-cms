{
  "extends": "@espress/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "moduleResolution": "NodeNext",
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@espress/ui/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
